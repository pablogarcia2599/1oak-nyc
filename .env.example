# ─── Fourvenues Channel Manager API ──────────────────────────────────────────
# Leave FOURVENUES_API_KEY empty to run the whole site in mock mode.
FOURVENUES_API_KEY=
FOURVENUES_BASE_URL=https://channels-service.fourvenues.com
# Staging: https://channels-service-alpha.fourvenues.com
FOURVENUES_ORGANIZATION_ID=

# Force mock data (1) or force live API (0). Omit to auto-detect from the key.
FOURVENUES_MOCK=

# Absolute origin used to build the payment redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3050

# Password gate for a private preview deployment. Leave empty to disable.
# Set this in Vercel, never in the repository.
SITE_PASSWORD=
